# Allow directories for review folders (must come before file patterns)
!uploads/facility/
!uploads/logos/
!uploads/team/

# Allow specific image files in review folders to be tracked
!uploads/facility/*.jpg
!uploads/facility/*.JPG
!uploads/facility/*.png
!uploads/facility/*.PNG
!uploads/facility/*.gif
!uploads/facility/*.webp
!uploads/facility/*.jpeg
!uploads/facility/*.JPEG
